  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 172b4d84e01932447ba06ea2089a3b7e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NSMB.World.WorldDialogueTrigger
  speaker: ERIK
  lines:
  - "ERIK (luigi.tmp)|Oh! A visitor. Welcome to the World \u2014 the walkable half
    of erikgaren.com."
  - 'DAVID (mario.tmp)|I''m David. Erik is also me, long story. We''re wearing plumbers
    until the real models are sculpted. Nintendo: temporary, honest.'
  - "ERIK (luigi.tmp)|Press C to swap views. Free 3D lets you wander; the side view
    snaps us back to 2.5D \u2014 3D world, gameplay on one plane, the way this game
    has always worked."
  once: 1
