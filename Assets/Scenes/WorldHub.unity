  m_Script: {fileID: 11500000, guid: 172b4d84e01932447ba06ea2089a3b7e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NSMB.World.WorldDialogueTrigger
  speaker: ERIK
  lines:
  - "ERIK (luigi.tmp)|Oh! A visitor! Welcome to the World. I'm Erik \u2014 or I will
    be, once the boss sculpts me a body. For now I'm, um. Borrowing Luigi."
  - "DAVID (mario.tmp)|And I'm David \u2014 same person as Erik, long story, good
    lore. Currently shaped like a certain plumber. Nintendo, if you're reading this:
    placeholders! Temporary! Don't sue, pweaseeee."
  - "ERIK (luigi.tmp)|He's serious, there's a roadmap and everything. This test map
    is stitched from the Versus stages \u2014 walk on, we'll explain him as we go."
  once: 1
