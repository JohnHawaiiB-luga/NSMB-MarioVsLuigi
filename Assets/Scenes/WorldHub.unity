  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NSMB.World.WorldDialogueTrigger
  speaker: ERIK
  lines:
  - 'ERIK (luigi.tmp)|Day job: at a BMW supplier he designed the team''s pre-delivery
    QA tool. 1,300 automated checks on 3D vehicle data, every single release.'
  - DAVID (mario.tmp)|It caught real defects before they shipped. I was 21 when I
    built it. Still am, actually.
  once: 1
